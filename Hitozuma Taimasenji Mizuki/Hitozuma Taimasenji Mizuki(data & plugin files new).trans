["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"]],"parameters":[],"indexIds":{"MadeWithMv":0,"auto":1,"A lotta":2,"SimHei, Heiti TC, sans-serif":3,"Dotum, AppleGothic, sans-serif":4,"sans-serif, GameFont, Verdana, Arial, Courier New":5,"left":6,"Graphics.width":7,"Window_Base._faceWidth + 24":8,"control":9,"sans-serif, GameFont":10,"this.standardPadding() * 2":11,"\\fn<GameFontB> \\ow[8] \\oc[15]":12,"mplus-1c-heavy":13,"MPlus 1C Heavy":14,"セーブ":15,"scene":16,"save":17,"ロード":18,"load":19,"Cursor1":20,"center":21,"bottom":22,"shift":23,"\"// Establish basic measurements\\nvar padding = backlogWindow.standardPadding();\\nvar width = padding / 2;\\nvar height = Graphics.boxHeight;\\n\\n// Calculate number of visible rows\\nvar visibleRows = backlogWindow.height - padding * 2;\\nvisibleRows = Math.floor(visibleRows / backlogWindow.lineHeight());\\nif (visibleRows < backlogWindow.maxItems()) {\\n  height *= visibleRows / Math.max(1, backlogWindow.maxItems());\\n}\\n\\n// Calculate the size of a basic scrolling increment\\nvar max = Math.floor(Math.max(1, backlogWindow.maxItems()) / backlogWindow.maxCols()) - 1;\\nthis._increment = Graphics.boxHeight / Math.max(1, max);\\n\\n// Generate the bitmap\\nthis.bitmap = new Bitmap(width, height);\\nthis.bitmap.fillAll(backlogWindow.textColor(scrollBarColor));\"":24,"rgba(0, 0, 0, 0.8)":25,"Message Speed":26,"Instant":27,"General":28,"\"General settings that alter the way the game behaves.\"":29,"常時ダッシュ":30,"\"Player walks when OFF. Player dashes when ON.\\nHolding SHIFT switches between walking and dashing.\"":31,"alwaysDash":32,"\"show = true;\"":33,"\"enabled = true;\"":34,"\"ext = 0;\"":35,"\"this.addCommand(name, symbol, enabled, ext);\"":36,"\"var rect = this.itemRectForText(index);\\nvar statusWidth = this.statusWidth();\\nvar titleWidth = rect.width - statusWidth;\\nthis.resetTextColor();\\nthis.changePaintOpacity(this.isCommandEnabled(index));\\nthis.drawOptionsName(index);\\nthis.drawOptionsOnOff(index);\"":37,"\"var index = this.index();\\nvar symbol = this.commandSymbol(index);\\nvar value = this.getConfigValue(symbol);\\nthis.changeValue(symbol, !value);\"":38,"\"var index = this.index();\\nvar symbol = this.commandSymbol(index);\\nvar value = this.getConfigValue(symbol);\\nthis.changeValue(symbol, true);\"":39,"\"var index = this.index();\\nvar symbol = this.commandSymbol(index);\\nvar value = this.getConfigValue(symbol);\\nthis.changeValue(symbol, false);\"":40,"\"ConfigManager[symbol] = false;\"":41,"\"config[symbol] = ConfigManager[symbol];\"":42,"\"ConfigManager[symbol] = config[symbol];\"":43,"コマンド記憶":44,"\"Game remembers the last command selected during battle.\"":45,"commandRemember":46,"\\i[87]Message Speed":47,"\"Changes the speed text is displayed during messages.\"":48,"messageSpeed":49,"\"show = Imported.YEP_X_MessageSpeedOpt;\"":50,"\"var rect = this.itemRectForText(index);\\nvar statusWidth = this.statusWidth();\\nvar titleWidth = rect.width - statusWidth;\\nthis.resetTextColor();\\nthis.changePaintOpacity(this.isCommandEnabled(index));\\nthis.drawOptionsName(index);\\nvar value = this.getConfigValue(symbol);\\nvar rate = ((value) / 10).clamp(0, 1);\\nif (value > 10) {\\n  var gaugeColor1 = this.textColor(14);\\n  var gaugeColor2 = this.textColor(6);\\n} else {\\n  var gaugeColor1 = this.textColor(20);\\n  var gaugeColor2 = this.textColor(21);\\n}\\nthis.drawOptionsGauge(index, rate, gaugeColor1, gaugeColor2);\\nthis.drawText(this.statusText(index), titleWidth, rect.y, statusWidth, 'center');\"":51,"\"var index = this.index();\\nvar symbol = this.commandSymbol(index);\\nvar value = this.getConfigValue(symbol);\\nvalue += 1;\\nif (value > 11) value = 0;\\nvalue = value.clamp(0, 11);\\nthis.changeValue(symbol, value);\"":52,"\"var index = this.index();\\nvar symbol = this.commandSymbol(index);\\nvar value = this.getConfigValue(symbol);\\nvalue += 1;\\nvalue = value.clamp(0, 11);\\nthis.changeValue(symbol, value);\"":53,"\"var index = this.index();\\nvar symbol = this.commandSymbol(index);\\nvar value = this.getConfigValue(symbol);\\nvalue -= 1;\\nvalue = value.clamp(0, 11);\\nthis.changeValue(symbol, value);\"":54,"Debug Mode":55,"\"Help Description:\\nTurns Debug Mode ON/OFF.\\nAccess the Debug Menu by pressing F9 on the map.\"":56,"CheatsDebugMode":57,"\"var rect = this.itemRectForText(index);\\nvar statusWidth = this.statusWidth();\\nvar titleWidth = rect.width - statusWidth;\\nthis.resetTextColor();\\nthis.changePaintOpacity(this.isCommandEnabled(index));\\nthis.drawOptionsName(index);\\nvar halfStatusWidth = this.statusWidth() / 2;\\nvar symbol = this.commandSymbol(index);\\nvar value = $gameTemp.isPlaytest();\\nthis.changePaintOpacity(!value);\\nthis.drawText('OFF', titleWidth, rect.y, halfStatusWidth, 'center');\\nthis.changePaintOpacity(value);\\nthis.drawText('ON', titleWidth + halfStatusWidth, rect.y, halfStatusWidth, 'center');\"":58,"\"$gameTemp._isPlaytest = !$gameTemp._isPlaytest;\\nthis.redrawItem(this.index());\\nSoundManager.playCursor();\"":59,"\"$gameTemp._isPlaytest = true;\\nthis.redrawItem(this.index());\\nSoundManager.playCursor();\"":60,"\"$gameTemp._isPlaytest = false;\\nthis.redrawItem(this.index());\\nSoundManager.playCursor();\"":61,"Audio":62,"\"Adjust the audio settings for the game.\"":63,"マスターボリューム":64,"\"Adjusts the overall volume of the game.\"":65,"masterVolume":66,"\"var rect = this.itemRectForText(index);\\nvar statusWidth = this.statusWidth();\\nvar titleWidth = rect.width - statusWidth;\\nthis.resetTextColor();\\nthis.changePaintOpacity(this.isCommandEnabled(index));\\nthis.drawOptionsName(index);\\nvar value = this.getConfigValue(symbol);\\nvar rate = value / 100;\\nvar gaugeColor1 = this.textColor(22);\\nvar gaugeColor2 = this.textColor(23);\\nthis.drawOptionsGauge(index, rate, gaugeColor1, gaugeColor2);\\nthis.drawText(this.statusText(index), titleWidth, rect.y, statusWidth, 'center');\"":67,"\"var index = this.index();\\nvar symbol = this.commandSymbol(index);\\nvar value = this.getConfigValue(symbol);\\nvalue += this.volumeOffset();\\nif (value > 100) {\\n  value = 0;\\n}\\nvalue = value.clamp(0, 100);\\nthis.changeValue(symbol, value);\"":68,"\"var index = this.index();\\nvar symbol = this.commandSymbol(index);\\nvar value = this.getConfigValue(symbol);\\nvalue += this.volumeOffset();\\nvalue = value.clamp(0, 100);\\nthis.changeValue(symbol, value);\"":69,"\"var index = this.index();\\nvar symbol = this.commandSymbol(index);\\nvar value = this.getConfigValue(symbol);\\nvalue -= this.volumeOffset();\\nvalue = value.clamp(0, 100);\\nthis.changeValue(symbol, value);\"":70,"\"ConfigManager[symbol] = 100;\"":71,"\"var value = config[symbol];\\nif (value !== undefined) {\\n  ConfigManager[symbol] = Number(value).clamp(0, 100);\\n} else {\\n  ConfigManager[symbol] = 100;\\n}\"":72,"BGM音量":73,"\"Adjusts the volume of the background music.\"":74,"bgmVolume":75,"\"var rect = this.itemRectForText(index);\\nvar statusWidth = this.statusWidth();\\nvar titleWidth = rect.width - statusWidth;\\nthis.resetTextColor();\\nthis.changePaintOpacity(this.isCommandEnabled(index));\\nthis.drawOptionsName(index);\\nvar value = this.getConfigValue(symbol);\\nvar rate = value / 100;\\nvar gaugeColor1 = this.textColor(30);\\nvar gaugeColor2 = this.textColor(31);\\nthis.drawOptionsGauge(index, rate, gaugeColor1, gaugeColor2);\\nthis.drawText(this.statusText(index), titleWidth, rect.y, statusWidth, 'center');\"":76,"BGS音量":77,"\"Adjusts the volume of the background sound effects.\"":78,"bgsVolume":79,"ME音量":80,"\"Adjusts the volume of the melody effects\\nsuch as fanfares.\"":81,"meVolume":82,"SE音量":83,"\"Adjusts the volume of the sound effects.\"":84,"seVolume":85,"キャラクターボイス音量":86,"\"Adjusts the volume of the Character Voice\"":87,"cvVolume":88,"All":89,"\"A list of all of the game's settings.\"":90,"Exit":91,"\"Exit the Options Menu.\"":92,"D":93,"ok":94,"d":9