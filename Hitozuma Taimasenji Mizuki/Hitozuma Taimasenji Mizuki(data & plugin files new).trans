ndex":0,"headerParam":["",0,0,2]}],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[{"headerIndex":0,"headerParam":["",0,0,2]}],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":2,"headerParam":["",0,0,2]}],[],[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":3,"headerParam":["",0,0,2]}],[{"headerIndex":5,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":13,"headerParam":["",0,1,1]}],[],[],[],[],[{"headerIndex":0,"headerParam":["",0,0,2]}]],"indexIds":{"済南町":0,"美月":1,"<mizuki.angry.right>・・・　烈火ちゃん　いま何か聞こえなかった？ |#M_0001|":2,"<rekka.idle.left>ん？アタシは何も聞こえなかったぜ　美月姉 |#R_0001|":3,"<mizuki.sad.right>私の気のせいかしら・・・|#M_0002|":4,"<mizuki.angry.right>それと烈火ちゃん　美月姉って呼び方　いいかげん直してよね|#M_0003|":5,"<mizuki.idle.right>いつも言ってるでしょ？ 美月でいいわよ、美月で|#M_0004|":6,"<rekka.happy.left>そういうわけにはいかねぇっすよ |#R_0002|":7,"<rekka.idle.left>自分より8個も上のアラフォー近い\n美月姉さんのこと呼び捨てにはできねえっす|#R_0003|":8,"<mizuki.sad.right>烈火ちゃん・・・\n呼び捨てより失礼なこと言ってるからね・・・？|#M_0005|":9,"<mizuki.idle.right>まあいいわ　とにかく　\nパトロールを終わらせちゃいましょう|#M_0006|":10,"<mizuki.idle.right>どうやら今日も困っている人がたくさんいるみたいだわ|#M_0007|":11,"<rekka.idle.left>私たち対魔戦士の出番っすね！|#R_0004|":12,"<mizuki.happy.right>フフ　烈火ちゃんはいつも元気ね　それじゃあ、始めましょうか|#M_0008|":13,"\n 　　　街の困ってる人を助けましょう！":14,"自動実行イベント終了後":15,"烈火":16,"EV003":17,"むせかえるような\nにんにくと脂の匂い・・・たまらん！！！":18,"EV004":19,"あ～はらへった":20,"ラーメン食ったら風俗でもいこ":21,"EV005":22,"うう、私としたことが":23,"黒ウーロン茶を持ってくるのを\n忘れてしまった・・・":24,"このままじゃ私の大好きなにんにく脂ギトギトラーメンが\n完食できない・・・っ":25,"美月さん,申し訳ないが\n自販機で黒ウーロン茶をかってきてくれませんか？":26,"<rekka.idle.left>おいおい、対魔戦士は\nパシリじゃ・・・":27,"<mizuki.idle.right>まぁまぁいいじゃないの\n列火ちゃん\n黒ウーロン茶ね、任せてください":28,"おお・・・！\n恩に着ます・・・！":29,"自販機で黒ウーロン茶を入手しよう！":30,"この恩一生忘れませんぞ・・・！":31,"おお！！！\nそれは黒ウーロン茶！！！":32,"これで中性脂肪を気にせず\nにんにく脂ラーメンを堪能できます！！！":33,"<mizuki.happy.right>うふふ、良かったですね":34,"<mizuki.happy.right>ぐ～～～～":35,"<mizuki.sad.right>あらやだ、\n私もお腹すいちゃったわ":36,"\nミッションクリア！":37,"これで心置きなくデカ盛りラーメンを食べられます":38,"EV006":39,"大盛にするか・・・特盛にするか・・・":40,"EV007":41,"ここのラーメンは食べナビ4.27の超人気店なんだ！":42,"豚の脂を甘く煮て\nラーメンにどっさり乗せたにんにく脂ラーメンが大人気なんだ":43,"EV008":44,"さっきあっちの方に見かけない人たちが\nいたけどなんだったんだろう・・・":45,"EV009":46,"ブランコって本気で漕いだら\n一周できないかなぁ":47,"EV010":48,"\\n<爺>おお美月さん・・・\n実は困ったことがあってのう・・・":49,"<mizuki.idle.right>あら、どうしたんですか？":50,"\\n<爺>最近勃起がおさまらんてのう・・・":51,"\\n<爺>よかったら美月さん\n抜いてくれんか・・・？":52,"<mizuki.angry.right>おじいちゃん・・・":53,"<mizuki.angry.right>対魔戦士はそういう仕事ではないので\nお店に行ってください、おじいちゃん":54,"<rekka.idle.left>やれやれだぜ":55,"EV011":56,"最近腰が痛くてねぇ\nすまないがバスまでおぶってくれないかい？":57,"<rekka.idle.left>お安い御用だぜ\nばあさん！":58,"<rekka.idle.left>よいしょっと・・・":59,"ありがとうねぇ\n助かったわい":60,"<rekka.idle.left>これくらい、お安い御用だぜ":61,"最近物騒だからねぇ\nあんたらも気を付けるんじゃぞ":62,"EV012":63,"このバス現金使えるよな・・・？":64,"EV013":65,"最近物騒ですからねぇ\nこの街くらいは平和であってほしいですよ":66,"EV014":67,"おにぎり１００円フェア！と書いてある・・・":68,"EV015":69,"<mizuki.idle.right>えーと黒ウーロン茶は・・・":70,"<mizuki.idle.right>ここにはないみたい・・・\n他を探しましょう":71,"EV016":72,"<mizuki.idle.right>あった黒ウーロン茶！\nこれをぽちっと・・・":73,"ガコンっ":74,"<mizuki.happy.right>これを並んでる\nおじさんに渡して依頼完了ね！":75,"黒ウーロン茶を手に入れた！":76,"EV017":77,"えーんえーん！！":78,"<mizuki.idle.right>あらあら、どうしたの？":79,"ルナがいなくなっちゃったの！！！":80,"<rekka.idle.left>ルナってのは猫か？":81,"そうなの・・・\n私が玄関をあけたらビゃって外にでちゃったの・・・":82,"<mizuki.idle.right>女の子がそんなに泣かないの":83,"<rekka.idle.left>そうだぞ、私たちが\n見つけてきてやっから":84,"ぐすぐす・・・\nお願いします・・・ぐす":85,"脱走した猫を探しましょう":86,"ぐすぐす・・・\nルナぁ・・・":87,"ルナ！！！！！":88,"にゃ～ん":89,"<mizuki.happy.right>うふふ、良かったわね":90,"<rekka.idle.left>もう逃がすんじゃねーぞ":91,"お姉ちゃんたちありがとう！！！":92,"私も大きくなったら対魔戦士になる！":93,"<mizuki.surprise.right>えーと":94,"<mizuki.happy.right>それはどうかしらね・・・\n親御さんときちんと話し合ってからでも・・・":95,"依頼完了！":96,"お姉ちゃんたちみたいな立派な\n対魔戦士になるんだ！":97,"EV018":98,"最近私の友達が行方不明になったんです":99,"もしかしたら\n魔族の仕業かもって・・・":100,"うう・・心配です・・・":101,"EV019":102,"EV020":103,"EV021":104,"EV022":105,"EV023":106,"EV024":107,"EV025":108,"EV026":109,"EV027":110,"EV028":111,"EV029":112,"EV030":113,"EV031":114,"EV032":115,"EV033":116,"EV034":117,"EV035":118,"EV036":119,"EV037":120,"EV038":121,"EV039":122,"EV040":123,"EV041":124,"EV042":125,"EV043":126,"EV044":127,"EV045":128,"EV047":129,"ブ