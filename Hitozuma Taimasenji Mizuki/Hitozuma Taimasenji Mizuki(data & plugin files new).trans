ame"],["Map126/events/37/name"]],"tags":[[],[],["gold"],[],[],[],[],[],[],[],[],[],[],[],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"]],"parameters":[[],[],[],[{"headerIndex":10,"headerParam":["",0,0,2]}],[{"headerIndex":13,"headerParam":["",0,1,1]},{"headerIndex":23,"headerParam":["",0,1,1]}],[{"headerIndex":15,"headerParam":["",0,0,2]}],[{"headerIndex":17,"headerParam":["",0,0,2]}],[{"headerIndex":19,"headerParam":["",0,0,2]}],[{"headerIndex":21,"headerParam":["",0,0,2]}],[{"headerIndex":25,"headerParam":["",0,0,2]}],[{"headerIndex":33,"headerParam":["",0,0,2]}],[{"headerIndex":35,"headerParam":["",0,0,2]}],[{"headerIndex":37,"headerParam":["",0,0,2]}],[{"headerIndex":40,"headerParam":["",0,0,2]}],[],[],[],[],[],[],[],[],[],[],[],[],[]],"indexIds":{"???":0,"<BattleMode>\n<Player:akari>\n<Live2DCharacter:akari>":1,"EV001":2,"<syokusyu.syokusyu1.event>っく・・・":3,"にゅるっにゅるるっ♡にゅるっ♡":4,"\\n<あかり>うう・・私がこんなザコ触手なんかに・・・":5,"\\n<あかり>やめて・・・まとわりつかないで・・・ぇ":6,"\\n<あかり>この触手の粘液・・・":7,"\\n<あかり>身体が熱くなって頭がボーっとする・・・":8,"\\n<あかり>やめて・・・っ\n敏感なところ触らないで・・・っ♡":9,"\\n<あかり>んおっ♡":10,"\\n<あかり>はーはー♡":11,"\\n<あかり>だめ・・・この瘴気と・・・\n触手の粘液で・・・":12,"\\n<あかり>意識が・・・":13,"EV002":14,"EV014":15,"EV027":16,"EV028":17,"EV029":18,"EV030":19,"EV031":20,"EV032":21,"EV033":22,"EV034":23,"EV035":24,"EV036":25,"EV037":26},"extension":"json","dataType":"map","filename":"Map126","basename":"Map126.json","path":"data/Map126.json","relPath":"data/Map126.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":27,"length":27,"percent":100}},"data/Map127.json":{"data":[["済南町","Jinan Town"],["美月","Mizuki"],["<mizuki.angry.right>・・・　烈火ちゃん　いま何か聞こえなかった？ |#M_0001|","<mizuki.angry.right>... Rekka-chan, did you not hear anything just? |#M_0001|"],["<rekka.idle.left>ん？アタシは何も聞こえなかったぜ　美月姉 |#R_0001|","<rekka.idle.left>Huh? I couldn't hear anything Mizuki-nee |#R_0001|"],["<mizuki.sad.right>私の気のせいかしら・・・|#M_0002|","<mizuki.sad.right>I wonder if it's just my imagination...|#M_0002|"],["<mizuki.angry.right>それと烈火ちゃん　美月姉って呼び方　いいかげん直してよね|#M_0003|","<mizuki.angry.right>And Rekka-chan, how you call him Mizuki-nee, you're just fine with it, right|#M_0003|"],["<mizuki.idle.right>いつも言ってるでしょ？ 美月でいいわよ、美月で|#M_0004|","<mizuki.idle.right>You're always saying it, right? Mizuki is fine, Mizuki |#M_0004|"],["<rekka.happy.left>そういうわけにはいかねぇっすよ |#R_0002|","<rekka.happy.left>That's not possible |#R_0002|"],["<rekka.idle.left>自分より8個も上のアラフォー近い\n美月姉さんのこと呼び捨てにはできねえっす|#R_0003|","<rekka.idle.left>I'm closer to my 40s, 8 more than me\nYou can't call Mizuki-nee-san |#R_0003|"],["<mizuki.sad.right>烈火ちゃん・・・\n呼び捨てより失礼なこと言ってるからね・・・？|#M_0005|","<mizuki.sad.right>Rekka-chan...\nIt's more rude than calling you out...? |#M_0005|"],["<mizuki.idle.right>まあいいわ　とにかく　\nパトロールを終わらせちゃいましょう|#M_0006|","<mizuki.idle.right>It's fine anyway\nLet's finish the patrol|#M_0006|"],["<mizuki.idle.right>どうやら今日も困っている人がたくさんいるみたいだわ|#M_0007|","<mizuki.idle.right>It seems there are many people who are in trouble today as well|#M_0007|"],["<rekka.idle.left>私たち対魔戦士の出番っすね！|#R_0004|","<rekka.idle.left>We are anti-demon warriors! |#R_0004|"],["<mizuki.happy.right>フフ　烈火ちゃんはいつも元気ね　それじゃあ、始めましょうか|#M_0008|","<mizuki.happy.right>Hehe, Rekka-chan is always doing well. So let's start, shall we? |#M_0008|"],["\n 　　　街の困ってる人を助けましょう！","\n Let's help those in need in the city!"],["自動実行イベント終了後","After the automatic execution event ends"],["烈火","Revive"],["EV003","EV003"],["むせかえるような\nにんにくと脂の匂い・・・たまらん！！！","It's like choking\nThe smell of garlic and fat... I can't take it! ! !"],["EV004","EV004"],["あ～はらへった","Ah, it's gone"],["ラーメン食ったら風俗でもいこ","If you eat ramen, you can go to the sex industry"],["EV005","EV005"],["うう、私としたことが","Ugh, what I did"],["黒ウーロン茶を持ってくるのを\n忘れてしまった・・・","Bring me some black oolong tea\nI forgot..."],["このままじゃ私の大好きなにんにく脂ギトギトラーメンが\n完食できない・・・っ","If it continues like this, my favorite garlic fatty ramen will be\nI can't finish it..."],["美月さん,申し訳ないが\n自販機で黒ウーロン茶をかってきてくれませんか？","Mizuki-san, sorry\nWould you like to drink some black oolong tea from the vending machine?"],["<rekka.idle.left>おいおい、対魔戦士は\nパシリじゃ・・・","<rekka.idle.left>Hey, the anti-demon warrior is\nIt's a bit sloppy..."],["<mizuki.idle.right>まぁまぁいいじゃないの\n列火ちゃん\n黒ウーロン茶ね、任せてください","<mizuki.idle.right>It's pretty good\nFire\nBlack oolong brown, leave it to me"],["おお・・・！\n恩に着ます・・・！","oh···!\nI'll be grateful for this...!"],["自販機で黒ウーロン茶を入手しよう！","Get black oolong tea from the vending machine!"],["この恩一生忘れませんぞ・・・！","I will never forget this kindness forever...!"],["おお！！！\nそれは黒ウーロン茶！！！","oh! ! !\nIt's black oolong brown! ! !"],["これで中性脂肪を気にせず\nにんにく脂ラーメンを堪能できます！！！","This doesn't bother you with triglycerides\nYou can enjoy garlic fat ramen! ! !"],["<mizuki.happy.right>うふふ、良かったですね","<mizuki.happy.right>Hehe, that's good"],["<mizuki.happy.right>ぐ～～～～","<mizuki.happy.right>Guu~"],["<mizuki.sad.right>あらやだ、\n私もお腹すいちゃったわ","<mizuki.sad.right>Oh no,\nI'm hungry too"],["\nミッションクリア！","\nComplete the mission!"],["これで心置きなくデカ盛りラーメンを食べられます","Now you can eat a large portion of ramen without worrying about it"],["EV006","EV006"],["大盛にするか・・・特盛にするか・・・","Should I make a large portion... or a special portion..."],["EV007","EV007"],["ここのラーメンは食べナビ4.27の超人気店なんだ！","The ramen here is a super popular restaurant with Tabe Navi 4.27!"],["豚の脂を甘く煮て\nラーメンにどっさり乗せたにんにく脂ラーメンが大人気なんだ","Sweet pork fat\nGarlic fat ramen with lots of ramen on top is very popular"],["EV008","EV008"],["さっきあっちの方に見かけない人たちが\nいたけどなんだったんだろう・・・","People who haven't seen them over there before\nThere was, but I wonder what it was..."],["EV009","EV009"],["ブランコって本気で漕いだら\n一周できないかなぁ","If you're serious about swinging\nCan't go around"],["EV010","EV010"],["\\n<爺>おお美月さん・・・\n実は困ったことがあってのう・・・","\\n<爺>Oh Mizuki...\nActually, I've had a problem..."],["<mizuki.idle.right>あら、どうしたんですか？","<mizuki.idle.right>Oh, what's wrong?"],["\\n<爺>最近勃起がおさまらんてのう・・・","\\n<爺> I haven't had an erection lately..."],["\\n<爺>よかったら美月さん\n抜いてくれんか・・・？","\\n<爺> If you like it, Mizuki-san\nCan you take it out...?"],["<mizuki.angry.right>おじいちゃん・・・","<mizuki.angry.right>Grandpa..."],["<mizuki.angry.right>対魔戦士はそういう仕事ではないので\nお店に行ってください、おじいちゃん","<mizuki.angry.right>An anti-demon warrior is not that kind of job\nGo to the store, Grandpa"],["<rekka.idle.left>やれやれだぜ","<rekka.idle.left>Oh no"],["EV011","EV011"],["最近腰が痛くてねぇ\nすまないがバスまでおぶってくれないかい？","My back has been hurting lately\nSorry, could you even send me a bus?"],["<rekka.idle.left>お安い御用だぜ\nばあさん！","<rekka.idle.left>It's cheap\nGrandma!"],["<rekka.idle.left>よいしょっと・・・","<rekka.idle.left>I'm glad..."],["ありがとうねぇ\n助かったわい","Thank you\nIt was helpful"],["<rekka.idle.left>これくらい、お安い御用だぜ","<rekka.idle.left>This is the cheapest thing to buy"],["最近物騒だからねぇ\nあんたらも気を付けるんじゃぞ","It's been awful lately\nYou should be careful too"],["EV012","EV012"],["このバス現金使えるよな・・・？","Can you use this bus cash?"],["EV013","EV013"],["最近物騒ですからねぇ\nこの街くらいは平和であってほしいですよ","It's been awful lately\nI hope this town is at least peaceful."],["EV014","EV014"],["おにぎり１００円フェア！と書いてある・・・","Rice balls are 100 yen fair! It says..."],["EV015","EV015"],["<mizuki.idle.right>えーと黒ウーロン茶は・・・","<mizuki.idle.right>Um, black oolong tea..."],["<mizuki.idle.right>ここにはないみたい・・・\n他を探しましょう","<mizuki.idle.right>It doesn't seem to be here...\nLet's look elsewhere"],["EV016","EV016"],["<mizuki.idle.right>あった黒ウーロン茶！\nこれをぽちっと・・・","<mizuki.idle.right>An black oolong brown!\nClick on this..."],["ガコンっ","Gakon"],["<mizuki.happy.right>これを並んでる\nおじさんに渡して依頼完了ね！","<mizuki.happy.right>Located these\nGive it to the man and complete the request!"],["黒ウーロン茶を手に入れた！","I got some black oolong tea!"],["EV017","EV017"],["えーんえーん！！","Oh no! !"],["<mizuki.idle.right>あらあら、どうしたの？","<mizuki.idle.right>Oh, what's wrong?"],["ルナがいなくなっちゃったの！！！","Luna is gone! ! !"],["<rekka.idle.left>ルナってのは猫か？","<rekka.idle.left>Is Luna a cat?"],["そうなの・・・\n私が玄関をあけたらビゃって外にでちゃったの・・・","That's right...\nWhen I opened the entrance, I went outside..."],["<mizuki.idle.right>女の子がそんなに泣かないの","<mizuki.idle.right>Girls don't cry that much"],["<rekka.idle.left>そうだぞ、私たちが\n見つけてきてやっから","<rekka.idle.left>That's right, we\nI'll find it"],["ぐすぐす・・・\nお願いします・・・ぐす","It's sniffing...\nPlease..."],["脱走した猫を探しましょう","Find a cat that escaped"],["ぐすぐす・・・\nルナぁ・・・","It's sniffing...\nLuna..."],["ルナ！！！！！","Luna! ! ! ! !"],["にゃ～ん","Nyaaaah"],["<mizuki.happy.right>うふふ、良かったわね","<mizuki.happy.right>Hehe, that's good"],["<rekka.idle.left>もう逃がすんじゃねーぞ","<rekka.idle.left> Don't let me get away now"],["お姉ちゃんたちありがとう！！！","Thank you to the big sisters! ! !"],["私も大きくなったら対魔戦士になる！","When I grow up, I will become a demon warrior!"],["<mizuki.surprise.right>えーと","<mizuki.surprise.right>Eh"],["<mizuki.happy.right>それはどうかしらね・・・\n親御さんときちんと話し合ってからでも・・・","<mizuki.happy.right>I wonder what that is...\nEven if you have a proper discussion with your parents..."],["依頼完了！","Request completed!"],["お姉ちゃんたちみたいな立派な\n対魔戦士になるんだ！","Amazing like the older sisters\nBecome an anti-demon warrior!"],["EV018","EV018"],["最近私の友達が行方不明になったんです","My friend has recently disappeared"],["もしかしたら\n魔族の仕業かもって・・・","Maybe\nMaybe it's the work of a demon..."],["うう・・心配です・・・","Ugh... I'm worried..."],["EV019","EV019"],["EV020","EV020"],["EV021","EV021"],["EV022","EV022"],["EV023","EV023"],["EV024","EV024"],["EV025","EV025"],["EV026","EV026"],["EV027","EV027"],["EV028","EV028"],["EV029","EV029"],["EV030","EV030"],["EV031","EV031"],["EV032","EV032"],["EV033","EV033"],["EV034","EV034"],["EV035","EV035"],["EV036","EV036"],["EV037","EV037"],["EV038","EV038"],["EV039","EV039"],["EV040","EV040"],["EV041","EV041"],["EV042","EV042"],["EV043","EV043"],["EV044","EV044"],["EV045","EV045"],["EV047","EV047"],["ブレーキがすり減った自転車だ・・・","It's a bicycle with worn brakes..."],["EV048","EV048"],["鍵のかかってない自転車だ・・・\n危ない！","It's an unlocked bike...\ndangerous!"],["EV049","EV049"],["EV050","EV050"],["EV051","EV051"],["EV052","EV052"],["EV053","EV053"],["EV054","EV054"],["EV055","EV055"],["EV056","EV056"],["EV057","EV057"],["EV058","EV058"],["EV059","EV