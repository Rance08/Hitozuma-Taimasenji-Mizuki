eaderParam":["",0,1,1]}],[{"headerIndex":68,"headerParam":["",0,0,2]}],[{"headerIndex":70,"headerParam":["",0,0,2]}],[{"headerIndex":72,"headerParam":["",0,0,2]}],[{"headerIndex":76,"headerParam":["",0,0,2]}],[{"headerIndex":79,"headerParam":["",0,0,2]}],[{"headerIndex":81,"headerParam":["",0,0,2]}],[{"headerIndex":89,"headerParam":["",0,0,2]}],[{"headerIndex":91,"headerParam":["",0,0,2]}],[{"headerIndex":93,"headerParam":["",0,0,2]}],[{"headerIndex":95,"headerParam":["",0,0,2]}],[{"headerIndex":99,"headerParam":["",0,0,2]}],[{"headerIndex":101,"headerParam":["",0,1,1]}],[{"headerIndex":103,"headerParam":["",0,0,2]}],[{"headerIndex":106,"headerParam":["",0,1,1]}],[{"headerIndex":108,"headerParam":["",0,0,2]}],[{"headerIndex":111,"headerParam":["",0,0,2]}],[{"headerIndex":117,"headerParam":["",0,0,2]}],[{"headerIndex":119,"headerParam":["",0,0,2]}],[{"headerIndex":122,"headerParam":["",0,0,2]}],[{"headerIndex":126,"headerParam":["",0,0,2]}],[{"headerIndex":136,"headerParam":["",0,0,2]}],[{"headerIndex":138,"headerParam":["",0,0,2]}],[{"headerIndex":140,"headerParam":["",0,0,2]}],[{"headerIndex":142,"headerParam":["",0,0,2]}],[{"headerIndex":145,"headerParam":["",0,0,2]}],[{"headerIndex":147,"headerParam":["",0,0,2]}],[{"headerIndex":150,"headerParam":["",0,0,2]}],[{"headerIndex":153,"headerParam":["",0,0,2]}],[{"headerIndex":155,"headerParam":["",0,0,2]}],[{"headerIndex":157,"headerParam":["",0,0,2]}],[{"headerIndex":163,"headerParam":["",0,1,1]}],[],[{"headerIndex":9,"headerParam":["",0,0,2]}],[{"headerIndex":11,"headerParam":["",0,0,2]}],[{"headerIndex":14,"headerParam":["",0,0,2]}],[]],"indexIds":{"娼館前":0,"<Player:mizuki>\nLAYER_S 1 map06_base 0 0 255 1 0\nLAYER_S 1 map06_base2 0 0 255 2 0\nLAYER_S 2 map06_upper 0 0 255 5 0\nLAYER_S 3 map06_overlay 0 0 255 6 2\nLAYER_S 4 map06_lighting 0 0 255 11 3\n\n":1,"管理イベント_03":2,"EVENT ID\n002: セシリア\n003: ガイド魔族\n009: カメラ座標_娼館\n012: カメラ座標_入口":3,"<mizuki.angryB.left>それで どうやって侵入するの？|#M_0119|":4,"<sesiria.angry.right>仰られていた「準備」というのは\n何だったんですか？|#S_0051|":5,"\\n<ガイド魔族>そんなに慌てないでくれ 順番に説明するから":6,"\\n<ガイド魔族>まず潜入方法だが この入口から普通にはいる":7,"\\n<ガイド魔族>入口の横の機械が見えるだろ？\nあれが扉を通る人間の「対魔力」を監視してる":8,"\\n<ガイド魔族>「脅威になる対魔戦士」を検知したら\n警報が鳴る仕組みだ":9,"\\n<美月>ちょっとまって|#M_0121|":10,"<mizuki.angryB.left>対魔戦士が侵入できないのなら\nなぜあかりは侵入できたの？|#M_0122|":11,"\\n<ガイド魔族>言っただろう？ 「脅威になる対魔戦士」だって":12,"\\n<ガイド魔族>あいつの対魔力は\n脅威じゃないと判断されたんだろうな":13,"<mizuki.sadB.left>あの子はまだ 対魔戦士として未熟だった・・・|#M_0123|":14,"\\n<ガイド魔族>それでだ":15,"\\n<ガイド魔族>「脅威となる対魔戦士」でも侵入できる方法がある":16,"\\n<ガイド魔族>それは この俺と「仮奴隷契約」を結ぶことだ":17,"<mizuki.surpriseB.left>奴隷契約・・・！？|#M_0120|":18,"<sesiria.angry.right>それでその「仮奴隷契約」とはなんですか？|#S_0052|":19,"\\n<ガイド魔族>奴隷娼婦になる前の 簡易的な契約のことさ":20,"\\n<ガイド魔族>その契約を結ぶことで あの機械はお前たちを\n対魔戦士ではなく「奴隷娼婦」として認識する":21,"\\n<ガイド魔族>警報を鳴らさずに中に入れるってわけさ":22,"<mizuki.angryB.left>その契約、本当に大丈夫なの・・・？|#M_0124|":23,"\\n<ガイド魔族>準備ができたら言ってくれ":24,"<mizuki.angryB.left>それで、仮奴隷契約って\n具体的になにをするの？":25,"\\n<ガイド魔族>仮契約は簡単だ\n俺にキスをした後に":26,"\\n<ガイド魔族>「あなたの奴隷情婦になります」\nと誓うだけだ":27,"<mizuki.angryB.left>は！？":28,"<sesiria.surprise.right>キスって・・・\nそんな・・・想い人でもない人と\nそんなこと・・・":29,"\\n<ガイド魔族>だがここで俺と契約しなかったら\nこの娼館に入ることすらできないぜ？":30,"<mizuki.angryB.left>あかり・・・":31,"<mizuki.angryB.left>私たちがこうしている間にも\nあかりが・・・":32,"仮奴隷契約を結びますか？":33,"はい":34,"いいえ":35,"<mizuki.angryB.left>しょうがないわね・・\nさっさと済ませてしまいましょう・・・":36,"<mizuki.angryB.left>（これはあかりを救うため・・・）":37,"\\n<ガイド魔族>話が早くて助かるぜ":38,"\\n<ガイド魔族>じゃあ早く舌を出せ":39,"\\n<美月>わかってるわよ・・・っ":40,"んぅ・・・":41,"\\n<ガイド魔族>ほらもっと舌を動かせ":42,"く・・・いい気になって・・・":43,"<22_mizuki.kiss3.event>んぅ・・・\n（う・・臭い・・夫のキスと全然違う・・・）":44,"じゅるちゅるじゅるちゅるじゅるちゅるんじゅる":45,"\\n<魔族>（あ〜やっべ人妻対魔戦士のよだれうっま）":46,"（長い舌が私の口の中かき回してきて・・蹂躙されてる・・・）":47,"ちょ・・そろそろ・・終わりにして":48,"\\n<魔族>ち、次はシスターだ、はやめに終わらしちまおうぜ":49,"<sesiria.surprise.right>ああ・・アリス様":50,"<sesiria.surprise.right>思い人以外の\n人と口付けをしてしまう\n私をお許しください・・":51,"\\n<セシリア>んっ":52,"\\n<セシリア>（ああ・・・私の初めての口付けが魔族となんて・・・）":53,"\\n<魔族>ほら、あんたも舌うごかして":54,"\\n<セシリア>うう・・・わかりました・・・":55,"<22_seciria.kiss3.event>こ・・・こうれふか・・・？":56,"じゅるちゅるじゅるちゅる":57,"\\n<魔族>（うお〜あのアリス教の修道女長とキスしちまってる、\n甘くてうめぇ〜）":58,"じゅるちゅるじゅるちゅるじゅる":59,"んむっ\n（これが・・キス・・頭が真っ白になってしまいそう・・）":60,"い・・いい加減にしてください・・・！":61,"\\n<魔族>(ちっこれからって時に・・・まぁいい)":62,"\\n<魔族>これで仮奴隷情婦契約の準備は完了だ\nあとはあんたらが俺の奴隷情婦になると誓うだけだ":63,"\\n<美月>うう・・\n私はあなたの奴隷情婦になると誓います・・・\n（魔族にこんなこと・・・屈辱だわ・・）":64,"\\n<セシリア>私は・・あなたの奴隷情婦になると誓います・・・\n（ああ・・お許しくださいアリス様・・）":65,"\\n<美月>んっな・・なにこれ・・":66,"\\n<魔族>それは淫紋だ":67,"\\n<魔族>無事、仮奴隷情婦契約が完了した証拠だ":68,"\\n<魔族>仮契約の淫紋ならじきにきえるから安心しろ\nただ本契約の淫紋は一生消えないけどな":69,"\\n<セシリア>ああ・・神に支える私の身体にこんな淫紋が・・":70,"\\n<魔族>さぁ婦館に俺の部屋をとってある\nあとはお前らの好きにしていいぜ":71,"\\n<美月>セシリア・・落ち込んでいてもしょうがないわ\nあかりを・・みんなを助けましょう・・！":72,"\\n<セシリア>はい・・！必ずみんなを助け出します・・・！":73,"\\n<魔族>（くくく・・まんまと奴隷情婦契約しやがった）":74,"\\n<魔族>（お前ら二人ともぜってぇ\n俺の奴隷便器に調教してやるからな・・・）":75,"こうして私たちの奴隷娼婦潜入捜査が始まった・・・・":76,"EV002":77,"<mizuki.angryB.left>ここが娼館ね・・・":78,"<sesiria.angry.right>そうみたいですね・・・\nまがまがしい邪気で充満してます・・・":79,"<mizuki.angryB.left>ここにあかりが・・・\nまずはあの魔族を探しましょう・・・":80,"カメラ座標_娼館(009)":81},"extension":"json","dataType":"map","filename":"Map101","basename":"Map101.json","path":"data/Map101.json","relPath":"data/Map101.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":82,"length":82,"percent":100}},"data/Map102.json":{"data":[["苗床ダンジョン1階層","Nursebed Dungeon 1st floor"],["<BattleMode>\n<Player:mizuki_B>\n<Live2DCharacter:mizuki>\n\nLAYER 6 01-waterTex1 -0.5 -0.5 75 -2 0 0 3\nLAYER 7 02-waterTex2 0.3 -0.3 255 -2 0 0 3\nLAYER 8 02-waterTex2 -0.4 -0.4 255 -2 0 0 3","<BattleMode>\n<Player:mizuki_B>\n<Live2DCharacter:mizuki>\n\nLAYER 6 01-waterTex1 -0.5 -0.5 75 -2 0 0 3\nLAYER 7 02-waterTex2 0.3 -0.3 255 -2 0 0 3\nLAYER 8 02-waterTex2 -0.4 -0.4 255 -2 0 0 3"],["EV001","EV001"],["EV002","EV002"],["\\n<???>・・・つきさん・・・、美月さん・・・","\\n<???>...Tsuki-san..., Mizuki-san..."],["<mizuki.surpriseB.right>そんな・・・ 触手に、飲み込まれてしまった・・・ |#M1_0040|","<mizuki.surpriseB.right>That's not it... I was swallowed by tentacles... |#M1_0040|"],["<mizuki.sadB.right>あの子・・・ あんなことを言う子じゃなかったのに\n・・・ |#M1_0041|","<mizuki.sadB.right>That kid... he wasn't the kid who said that\n... |#M1_0041|"],["<mizuki.sadB.right>調教を受けると あんなことになってしまうの・・・\n？ |#M1_0042|","<mizuki.sadB.right>When I receive training, that's what happens...\n? |#M1_0042|"],["<mizuki.angryB.right>私が、こんな魔界生物のチンポなんかに 堕ちるわけ\nがない・・・ |#M1_0043|","<mizuki.angryB.right>Why am I falling for such a demon creature's dick?\nNone... |#M1_0043|"],["<mizuki.angryB.right>彼女たちには申し訳ないけど、いまは先を急がないと\n・・・ |#M1_0044|","<mizuki.angryB.right>I'm sorry to them, but I have to hurry up now.\n... |#M1_0044|"],["イベント終了","Event ends"],["EV003","EV003"],["EV004","EV004"],["collision_hookshot","collision_hookshot"],["EV005","EV005"],["どこかの呪いが解かれる音がした","I heard the sound of a curse being lifted somewhere"],["EV006","EV006"],["EV007","EV007"],["collision_id : 1","collision_id : 1"],["collision_id : 2","collision_id : 2"],["EV008","EV008"],["EV009","EV009"],["EV011","EV011"],["EV012","EV012"],["EV013","EV013"],["EV014","EV014"],["EV015","EV015"],["EV016","EV016"],["EV017","EV017"],["どこかで呪いが解かれる音がした","I heard the sound of the curse being lifted somewhere"],["EV018","EV018"],["EV019","EV019"],["EV020","EV020"],["EV021","EV021"],["EV022","EV022"],["EV023","EV023"],["EV024","EV024"],["EV025","EV025"],["EV026","EV026"],["EV027","EV027"],["EV028","EV028"],["EV029","EV029"],["EV030","EV030"],["EV031","EV031"],["EV032","EV032"],["EV033","EV033"],["EV034","EV034"],["EV035","EV035"],["EV036","EV036"],["EV037","EV037"],["EV038","EV038"],["EV039","EV039"],["EV040","EV040"],["EV041","EV041"],["EV042","EV042"],["EV043","EV043"],["EV044","EV044"],["EV045","EV045"],["EV046","EV046"],["EV047","EV047"],["EV048","EV048"],["EV049","EV049"],["EV050","EV050"],["EV051","EV051"],["EV052","EV052"],["EV053","EV053"],["EV054","EV054"],["EV055","EV055"],["EV056","EV056"],["EV057","EV057"],["\\n<美月>これはあかりが使っていた武器・・・","\\n<Mizuki> This is the weapon Akari used..."],["\\n<美月>あかり・・・大事に使わせてもらうわね・・・っ","\\n<Mizuki> Light... I'll use it carefully..."],["set_actor_item_current : HookShot","set_actor_item_current : HookShot"],["フックショットに変更しました","Changed to hook shot"],["set_actor_item_current : Bow","set_actor_item_current : Bow"],["弓矢に変更しました。","I changed to bow and arrow."],["EV058","EV058"],["EV059","EV059"],["\\n<美月>呪いがかかっていて先に進めない・・・！","\\n<Mizuki> is cursed and I can't move forward...!"],["\\n<美月>どこかに呪いを解く何かがあるはず・・・","\\n<Mizuki>There must be something somewhere that will lift the curse..."],["EV060","EV060"],["EV061","EV061"],["EV062","EV062"],["EV063","EV063"],["EV064","EV064"],["\\n<美月>壁に触手が張り付いてて気持ち悪いわね・・・","\\n<Mizuki> Tentacles sticking to the wall makes it creepy..."],["\\n<美月>急に襲われるかも入れないから慎重に\nすすみましょう・・・","\\n<Mizuki> You may be attacked suddenly, so be careful\nLet's proceed..."],["EV065","EV065"],["EV066","EV066"],["\\n<美月>うっ・・・足元がぬるぬるして\n気持ち悪い・・・","\\n<Mizuki>Uh... my feet are slippery\nfeel ill···"],["EV067","EV067"],["EV068","EV068"],["EV069","EV069"],["EV070","EV070"],["\\n<美月>ふぅ・・・なんとか抜けられそうね・・・","\\n<Mizuki>Heh...I think I can somehow get rid of it..."],["EV071","EV071"],["EV072","EV072"],["\\n<美月>はぁはぁ・・やっと触手の道から\n抜けられたようね・・・","\\n<Mizuki> Haa... Finally, from the tentacle path\nIt looks like you've been removed..."],["\\n<美月>なっ地面から触手が・・・！","\\n<Mizuki> Tentacles come from the ground...!"],["EV073","EV073"],["EV074","EV074"],["EV075","EV075"],["EV076","EV076"],["EV077","EV077"],["EV078","EV078"],["EV079","EV079"],["EV080","EV080"],["EV081","EV081"],["EV082","EV082"],["EV083","EV083"],["EV084","EV084"],["EV085","EV085"],["EV086","EV086"],["EV087","EV087"],["EV088","EV088"],["enemy_id : 13","enemy_id : 13"],["EV089","EV089"],["EV090","EV090"],["EV091","EV091"],["EV092","EV092"],["EV093","EV093"],["EV094","EV094"],["EV095","EV095"],["EV096","EV096"],["EV097","EV097"],["EV098","EV098"],["EV099","EV099"],["EV100","EV100"],["EV101","EV101"],["EV102","EV102"],["EV103","EV103"],["EV104","EV104"],["EV105","EV105"],["EV106","EV106"],["EV107","EV107"],["EV108","EV108"],["EV109","EV109"],["<mizuki.angryB.right>ここが奴隷娼婦生成ダンジョン","<mizuki.angryB.right>This is the slave prostitute's dungeon"],["<