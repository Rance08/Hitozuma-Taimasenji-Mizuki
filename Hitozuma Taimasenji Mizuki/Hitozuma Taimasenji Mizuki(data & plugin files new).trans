aderIndex":15,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["自動実行イベントの完了"]}],[],[],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":2,"headerParam":["",0,0,2]}],[],[{"headerIndex":0,"headerParam":["",0,0,2]}],[],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":2,"headerParam":["",0,0,2]}],[],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":2,"headerParam":["",0,0,2]}],[],[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":2,"headerParam":["",0,0,2]},{"headerIndex":2,"headerParam":["",0,0,2]}],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[]],"indexIds":{"美月の家":0,"<Player:mizuki>\nLAYER_S 1 map04_base 0 0 255 1 0":1,"EV001":2,"夫との会話完了後に有効化\n接触したらセシリア教会イベントに遷移":3,"娼館に向かいますか？":4,"はい":5,"いいえ":6,"\\n<美月>(魔族娼館・・・)|#M_0111|":7,"\\n<美月>(あの建物が怪しいことは対魔戦士なら\n誰でも分かってた・・・)|#M_0112|":8,"\\n<美月>(何度捜査しようとしても 魔族が拒否し続けてきた・・・)|#M_0114|":9,"\\n<美月>(まさかこんな形で潜入することになるなんて・・・)|#M_0115|":10,"\\n<美月>(あかり待っててね・・・必ず助け出すわ)|#M_0116|":11,"美月夫(002)":12,"[物語]夫に別れを告げる美月":13,"<mizuki.sad.left>ねえ あなた・・・|#M_0100|":14,"\\n<夫>おお 美月！帰ったのか！":15,"\\n<夫>あかりは一緒じゃないのか？":16,"<mizuki.sad.left>ええ あの子は泊まり込みで訓練をしてるわ\n対魔戦士の本部で・・・|#M_0101|":17,"\\n<夫>そうなのか！さすがだな！\n本当に真面目な子だ":18,"<mizuki.sad.left>うん あの子はすごく頑張ってる・・・|#M_0102|":19,"\\n<夫>将来は君と同じ S級対魔戦士になって\n多くの人を助けるんだろうな！":20,"<mizuki.sad.left>ええ そうね|#M_0103|":21,"<mizuki.sad.left>あなた じつは私 これから仕事があるの|#M_0104|":22,"\\n<夫>これから？ もう夜になるぞ？":23,"<mizuki.sad.left>とても大切な仕事なの|#M_0105|":24,"<mizuki.sad.left>それと もしかしたら\nしばらく家に帰れないかもしれない・・・|#M_0106|":25,"\\n<夫>・・・！":26,"\\n<夫>難しい仕事 なのか・・・？":27,"<mizuki.sad.left>ええ とても難しい仕事|#M_0107|":28,"\\n<夫>・・・わかった だが無理はしないでくれよ美月":29,"<mizuki.idle.left>ええ|#M_0108|":30,"\\n<夫>美月・・・":31,"<mizuki.idle.left>あなた・・・":32,"\n   　　　　　　チュッ♡":33,"んっ・・・":34,"\\n<夫>愛してる":35,"わたしも|#M_0109|":36,"\\n<夫>無事に帰ってこいよ":37,"\\n<美月>ええ・・・":38,"ストーリー会話終了時":39,"\\n<夫>頑張ってこいよ 美月":40,"\\n<夫>応援してる":41,"EV003":42,"管理イベント_03":43,"EVENT ID\n002: 美月夫":44,"CAM PLAYER":45,"\\n<美月>(あかり・・・あんなひどい目にあってるなんて・・・)|#M_0096|":46,"\\n<美月>(いますぐ助けに行きたいけど\nいまはあの魔族を待つことしかできない・・・)|#M_0097|":47,"CAM EVENT 002":48,"\\n<美月>(しばらく家に帰れないかもしれない\nあのひとに伝えておかないと・・・)|#M_0099|":49,"自動実行イベントの完了":50,"EV005":51,"EV006":52,"あかりの食べかけのお菓子だ・・・":53,"帰ってきたらうんと叱ってあげないと・・・":54,"EV007":55,"昨日、夫と飲んでいたワインだ・・・":56,"EV008":57,"あかりの飲みかけのジュースだ・・・":58,"最後の一口分だけが残されている・・・":59,"EV009":60,"烈火ちゃんから貰った果物だ・・・":61,"祝！歴代二人目のS級対魔戦士と書かれている・・・":62,"EV010":63,"家族写真だ・・・":64,"幼いあかりが\nひまわりを頭に乗せて笑っている・・・":65,"EV011":66,"EV012":67,"EV013":68,"EV014":69,"EV015":70,"EV016":71,"EV017":72,"EV018":73,"EV019":74,"EV020":75,"EV021":76,"EV022":77,"EV023":78,"EV024":79,"EV025":80,"EV026":81,"EV027":82,"EV028":83,"EV029":84,"EV030":85,"EV031":86,"EV032":87,"EV033":88,"EV034":89,"EV035":90,"EV036":91,"EV037":92,"EV038":93,"EV039":94,"EV040":95,"EV041":96,"EV042":97,"EV043":98,"EV044":99,"EV045":100,"EV046":101,"EV047":102,"EV048":103,"EV049":104,"EV050":105,"EV051":106,"EV052":107,"EV053":108,"EV054":109,"EV055":110,"EV056":111,"EV057":112,"EV058":113,"EV059":114,"EV060":115,"EV061":116,"EV062":117,"EV063":118,"EV064":119,"EV065":120,"EV066":121,"EV067":122,"EV068":123,"EV069":124,"EV070":125,"EV071":126,"EV072":127,"EV073":128,"EV074":129,"EV075":130,"EV076":131,"EV077":132,"EV078":133,"EV079":134,"EV080":135,"EV081":136,"EV082":137,"EV083":138,"EV084":139,"EV085":140,"EV086":141,"EV087":142,"EV088":143,"EV089":144,"EV090":145,"EV091":146,"EV092":147,"EV093":148,"EV094":149,"EV095":150,"EV096":151,"EV097